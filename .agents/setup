#!/usr/bin/env bash
# -*- shell-script -*-
#
# .agents/setup — reproducible agent-friendly bootstrap for Endophasia.
#
# Mutates the local development environment to make a fresh checkout
# development-ready. Idempotent. Read-only resume lives in .agents/resume.
#
# Contract:
#  - Uses the repository-pinned Bun 1.3.13 (from .tool-versions), even when
#    the host shell resolves a newer Bun.
#  - Verifies Node >=22 before doing work.
#  - Cryptographically verifies downloaded Bun archives before installing.
#  - Installs frozen workspace dependencies from the repository root.
#  - Builds only the minimum artifacts needed for ordinary SDK/CLI development.
#  - Does not start services, download credentials, open browsers, or touch
#    GUI/native/desktop stacks.
#  - Supports Linux x86_64 (qualified). Linux aarch64 is coded but UNVERIFIED.
#    Other platforms are rejected.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT

# ── helpers ────────────────────────────────────────────────────────────────

fail() {
  printf '❌ %s\n' "$*" >&2
  exit 1
}

info() { printf 'ℹ️  %s\n' "$*"; }
ok()   { printf '✅ %s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*" >&2; }

# ── OS / platform contract ─────────────────────────────────────────────────

# This bootstrap is qualified for Linux x86_64 only.
#
# Unsupported OS/architecture combinations fail immediately and explicitly.
# No Darwin logic is included (macOS is untested and the resume script uses
# Linux-specific `stat -c '%Y'`). No Linux aarch64 logic is included — its
# official digest is available but the path has not been exercised on this host.

case "$(uname -s)" in
  Linux)
    ;;
  *)
    fail "Unsupported OS: $(uname -s). This bootstrap targets Linux only."
    ;;
esac

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)
    ;;
  *)
    fail "Unsupported architecture: $ARCH. This bootstrap targets Linux x86_64 only."
    ;;
esac

# ── locate repository truth ────────────────────────────────────────────────

if [[ ! -f "$REPO_ROOT/.tool-versions" ]]; then
  fail ".tool-versions missing from repo root; cannot determine required toolchain."
fi

# Parse .tool-versions: "bun 1.3.13" / "node 22"
read_tool_version() {
  local tool="$1"
  local ver
  ver="$(
    awk -v tool="$tool" '
      $1 == tool { print $2; found=1; exit }
      END { if (!found) print "" }
    ' "$REPO_ROOT/.tool-versions"
  )"
  printf '%s' "$ver"
}

REQUIRED_BUN_VERSION="$(read_tool_version bun)"
REQUIRED_NODE_MAJOR="$(read_tool_version node)"

if [[ -z "$REQUIRED_BUN_VERSION" ]]; then
  fail "Could not read Bun version from .tool-versions"
fi
if [[ -z "$REQUIRED_NODE_MAJOR" ]]; then
  fail "Could not read Node major version from .tool-versions"
fi

info "Repository requires Bun $REQUIRED_BUN_VERSION and Node >= $REQUIRED_NODE_MAJOR."

# ── Node compatibility (must precede work) ────────────────────────────────

check_node_compatibility() {
  local node_version
  node_version="$(node --version 2>/dev/null || true)"

  if [[ -z "$node_version" ]]; then
    fail "node not found on PATH. The repository requires Node >= $REQUIRED_NODE_MAJOR."
  fi

  # node --version prints "v26.8.2" or "v22.0.0". Strip leading "v" and take
  # the first dot-separated field as the major version.
  local major
  major="${node_version#v}"
  major="${major%%.*}"

  if [[ ! "$major" =~ ^[0-9]+$ ]]; then
    fail "Could not parse Node major version from '$node_version'."
  fi

  if [[ "$major" -lt "$REQUIRED_NODE_MAJOR" ]]; then
    fail "Node $major is below the required minimum of $REQUIRED_NODE_MAJOR. " \
         "Upgrade Node to >= $REQUIRED_NODE_MAJOR (the repository requirement, " \
         "derived from .tool-versions and package.json engines fields)."
  fi

  NODE_VERSION="$node_version"
  NODE_MAJOR="$major"
}

check_node_compatibility
ok "Node $NODE_VERSION (major $NODE_MAJOR) satisfies Node >= $REQUIRED_NODE_MAJOR."

# ── put a repo-local Bun on PATH ───────────────────────────────────────────

# Strategy: install the pinned Bun version into .agents/.bun-local and
# prefix PATH with it. This leaves the system Bun untouched and makes the
# pinned version the one every subsequent command in this script uses.
#
# Installation path chosen over alternatives:
#  - system package managers: would mutate system state (against contract).
#  - bun upgrade: only targets latest stable/canary, cannot pin 1.3.13.
#  - mise/asdf: not available on this host; adding them would be a heavier
#    dependency than a single downloaded binary.
#  - pinned download + SHA-256 verification: minimal, reproducible, fail-closed.

LOCAL_BUN_DIR="$REPO_ROOT/.agents/.bun-local"
LOCAL_BUN_BIN="$LOCAL_BUN_DIR/bin"

# SHA-256 digests for Bun release archives, pinned per version + platform.
# Provenance: authoritative per-asset SHA-256 digests are published in the
#   GitHub release asset metadata for each Bun release. For Bun v1.3.13 the
#   `bun-linux-x64.zip` asset exposes `digest: 79c0771fa8b92c33aae41e15a0e0d307ea99d0e2f00317c71c6c53237a78e25a`
#   (verified locally against the downloaded asset and against the metadata).
#
#   Source: GitHub release asset metadata for
#     https://github.com/oven-sh/bun/releases/tag/bun-v1.3.13
#   Each release asset carries a `sha256` / `digest` field accessible via the
#   GitHub API (`gh api repos/oven-sh/bun/releases/tags/bun-v1.3.13`) or the
#   release web UI asset listing.
#
# The Linux x86_64 digest is the only one pinned and qualified for this PR.
# Other platforms are not supported by this bootstrap and have no entries.

declare -A BUN_SHA256=(
  ["bun-linux-x64.zip"]="79c0771fa8b92c33aae41e15a0e0d307ea99d0e2f00317c71c6c53237a78e25a"
)

# Resolve Bun 1.3.13 release archive URL.
resolve_bun_archive() {
  local os_name arch
  os_name="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"

  case "$os_name-$arch" in
    linux-x86_64)
      ARCHIVE_NAME="bun-linux-x64.zip"
      ;;
    *)
      fail "No prebuilt Bun $REQUIRED_BUN_VERSION archive for $os_name-$arch. " \
           "This bootstrap targets Linux x86_64 only. Install Bun $REQUIRED_BUN_VERSION manually."
      ;;
  esac

  URL="https://github.com/oven-sh/bun/releases/download/bun-v${REQUIRED_BUN_VERSION}/${ARCHIVE_NAME}"
}

# Install if the pinned binary is missing or the wrong version.
install_pinned_bun() {
  if [[ -x "$LOCAL_BUN_BIN/bun" ]]; then
    local current
    current="$("$LOCAL_BUN_BIN/bun" --version 2>/dev/null || true)"
    if [[ "$current" == "$REQUIRED_BUN_VERSION" ]]; then
      ok "Pinned Bun $REQUIRED_BUN_VERSION already installed at $LOCAL_BUN_BIN/bun"
      return 0
    else
      warn "Existing .agents/.bun-local bun is version $current; replacing with $REQUIRED_BUN_VERSION."
      rm -rf "$LOCAL_BUN_DIR"
    fi
  fi

  resolve_bun_archive

  # Verify the archive name has a pinned digest.
  if [[ -z "${BUN_SHA256[$ARCHIVE_NAME]+x}" ]]; then
    fail "No pinned SHA-256 digest for $ARCHIVE_NAME. " \
         "The archive is not in the supported set; do not proceed."
  fi

  local expected_digest="${BUN_SHA256[$ARCHIVE_NAME]}"

  # Special marker for unverified paths — fail closed.
  if [[ "$expected_digest" == "verifies_on_download" ]]; then
    fail "Bun archive $ARCHIVE_NAME is in the supported set but its SHA-256 " \
         "digest has not been verified on this host. This path (Linux aarch64) " \
         "is coded but UNVERIFIED. Do not proceed until a digest is pinned."
  fi

  info "Downloading Bun $REQUIRED_BUN_VERSION from ${URL} …"
  info "Expected SHA-256: ${expected_digest}"

  local tmpdir
  tmpdir="$(mktemp -d)"
  local archive_path="$tmpdir/$ARCHIVE_NAME"

  # Cleanup: remove the archive on any exit (success or failure). This ensures
  # a failed download or verification never leaves unverified bytes on disk.
  # Use parameter expansion with default to avoid 'unbound variable' under set -u
  # when the trap fires after this function has returned.
  cleanup() {
    rm -rf "${tmpdir:-}"
  }
  trap cleanup EXIT

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 2 --retry-delay 2 --location "$URL" -o "$archive_path" \
      || fail "Failed to download Bun $REQUIRED_BUN_VERSION from $URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --tries=2 --waitretry=2 "$URL" -O "$archive_path" \
      || fail "Failed to download Bun $REQUIRED_BUN_VERSION from $URL"
  else
    fail "Neither curl nor wget is available; cannot download Bun."
  fi

  # Verify SHA-256 before extracting or installing anything.
  local actual_digest
  actual_digest="$(sha256sum "$archive_path" 2>/dev/null | awk '{print $1}')"

  if [[ -z "$actual_digest" ]]; then
    fail "Could not compute SHA-256 of downloaded archive."
  fi

  if [[ "$actual_digest" != "$expected_digest" ]]; then
    fail "SHA-256 mismatch for Bun $REQUIRED_BUN_VERSION ($ARCHIVE_NAME).\n" \
         "  expected: ${expected_digest}\n" \
         "  actual:   ${actual_digest}\n" \
         "  Archive retained at: $archive_path (for inspection, then delete manually)\n" \
         "  Do not install or execute this archive."
  fi

  ok "SHA-256 verified for $ARCHIVE_NAME."

  mkdir -p "$LOCAL_BUN_DIR"
  unzip -q "$archive_path" -d "$LOCAL_BUN_DIR" \
    || fail "Failed to extract Bun archive."

  # Bun's zip ships a single top-level directory (e.g. bun-linux-x64/) with
  # the bun binary inside. Flatten it into $LOCAL_BUN_BIN so PATH works.
  local extracted_dir
  extracted_dir="$(find "$LOCAL_BUN_DIR" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
  if [[ -n "$extracted_dir" && -x "$extracted_dir/bun" ]]; then
    mkdir -p "$LOCAL_BUN_BIN"
    mv "$extracted_dir/bun" "$LOCAL_BUN_BIN/bun"
    mv "$extracted_dir/bunx" "$LOCAL_BUN_BIN/bunx" 2>/dev/null || true
    rmdir "$extracted_dir" 2>/dev/null || true
  fi

  if [[ ! -x "$LOCAL_BUN_BIN/bun" ]]; then
    fail "Extracted bun binary not found or not executable at $LOCAL_BUN_BIN/bun"
  fi

  ok "Installed Bun $REQUIRED_BUN_VERSION to $LOCAL_BUN_BIN/bun"
}

install_pinned_bun

export PATH="$LOCAL_BUN_BIN:$PATH"
hash -r 2>/dev/null || true

# Sanity: the PATH-prefixed bun must now report the pinned version.
CURRENT_BUN="$(bun --version 2>/dev/null || true)"
if [[ "$CURRENT_BUN" != "$REQUIRED_BUN_VERSION" ]]; then
  fail "After install, PATH-resolved bun reports '$CURRENT_BUN', expected '$REQUIRED_BUN_VERSION'."
fi

ok "Active Bun is $CURRENT_BUN (pinned)."

# ── SDK workspace root ─────────────────────────────────────────────────────

SDK_ROOT="$REPO_ROOT/sdk"

if [[ ! -d "$SDK_ROOT" ]]; then
  fail "SDK workspace root $SDK_ROOT missing; repository structure changed."
fi

if [[ ! -f "$SDK_ROOT/package.json" && ! -f "$REPO_ROOT/package.json" ]]; then
  # The SDK workspace is its own package root inside the monorepo.
  fail "No package.json found at SDK root ($SDK_ROOT) or repo root."
fi

info "SDK workspace root: $SDK_ROOT"

# ── dependency install (frozen) ───────────────────────────────────────────

# Bun 1.3.13 supports --frozen-lockfile. Install from the SDK workspace root
# so workspace:* resolutions are correct (see sdk/AGENTS.md).
cd "$SDK_ROOT"

# The monorepo's lockfile lives at the repository root (bun workspaces).
# SDK workspace operations (install + build) happen from sdk/, but the lockfile
# is rooted at $REPO_ROOT.
if [[ ! -f "$REPO_ROOT/bun.lock" ]]; then
  fail "bun.lock missing from repository root; cannot perform frozen install."
fi

info "Installing frozen dependencies (bun install --frozen-lockfile) …"
bun install --frozen-lockfile --cwd "$SDK_ROOT" \
  || fail "bun install --frozen-lockfile failed."

ok "Dependencies installed."

# ── SDK package build (minimum artifacts) ──────────────────────────────────

info "Building SDK packages (bun run build:sdk) …"
bun run build:sdk \
  || fail "bun run build:sdk failed."

ok "SDK packages built."

# ── readiness summary ──────────────────────────────────────────────────────

printf '\n'
printf '═══════════════════════════════════════════════════════════\n'
printf '  Development environment ready\n'
printf '═══════════════════════════════════════════════════════════\n'
printf '  repo root  : %s\n' "$REPO_ROOT"
printf '  sdk root   : %s\n' "$SDK_ROOT"
printf '  bun        : %s (pinned %s)\n' "$(bun --version)" "$REQUIRED_BUN_VERSION"
printf '  node       : %s\n' "${NODE_VERSION:-missing}"
printf '  bun.lock   : %s\n' "$(
    if [[ -f "$REPO_ROOT/bun.lock" ]]; then
      ls -la "$REPO_ROOT/bun.lock" | awk '{print $5, $NF}'
    else
      echo "missing"
    fi
  )"
printf '\n'
printf 'Next steps:\n'
printf '  • Run `.agents/resume` to verify readiness at any time.\n'
printf '  • Run `bun run build:sdk` from sdk/ after source changes.\n'
printf '  • Run `bun run test:unit` from sdk/ for focused tests.\n'
printf '\n'
exit 0
