{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"protocol/**/*.ts",
			"graph/**/*.ts",
			"runtime/**/*.ts",
			"adapters/**/*.ts",
			"presentation/**/*.ts",
			"cockpit/**/*.ts",
			"cockpit/**/*.css",
			"research/**/*.ts",
			"tests/**/*.ts",
			"scripts/**/*.ts",
			"!pi/**",
			"!node_modules/**",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts"
		]
	},
	"plugins": ["./scripts/biome/model-type-comparison.grit"]
}
