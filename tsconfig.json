{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	"include": [
		"protocol/**/*",
		"cockpit/**/*",
		"cockpit-http/**/*",
		"graph/**/*",
		"visualization/**/*",
		"lab/**/*",
		"evolution/**/*",
		"trust/**/*",
		"collab/**/*",
		"runtime/**/*",
		"adapters/**/*",
		"research/**/*",
		"models/**/*",
		"storage/**/*",
		"cli/**/*",
		"scripts/**/*",
		"tests/**/*"
	],
	"exclude": ["**/dist/**", "node_modules"]
}
