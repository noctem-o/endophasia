) => e.onHand > 0 || e.reserved > 0)\n\t\t\t.map(([sku, e]) => ({ sku, onHand: e.onHand, reserved: e.reserved, available: e.onHand - e.reserved }))\n\t\t\t.sort((a, b) => a.sku.localeCompare(b.sku));\n\t}\n}\n","tool_call_id":"b8vCXi3Ipo8ZlNPYqoJQz2GAETv0VO2D"},{"role":"tool","content":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { Inventory } from \"../src/inventory.js\";\n\ntest(\"add and snapshot\", () => {\n\tconst inv = new Inventory();\n\tinv.add(\"ab-1\", 5);\n\tinv.add(\" AB-1 \", 2);\n\tassert.deepEqual(inv.snapshot(), [{ sku: \"AB-1\", onHand: 7, reserved: 0, available: 7 }]);\n});\n\ntest(\"reserve and release\", () => {\n\tconst inv = new Inventory();\n\tinv.add(\"X\", 10);\n\tinv.reserve(\"X\", 4);\n\tassert.throws(() => inv.reserve(\"X\", 7), RangeError);\n\tinv.release(\"X\", 1);\n\tassert.deepEqual(inv.snapshot(), [{ sku: \"X\", onHand: 10, reserved: 3, available: 7 }]);\n});\n\ntest(\"remove\", () => {\n\tconst inv = new Inventory();\n\tinv.add(\"X\", 3);\n\tinv.remove(\"X\", 3);\n\tassert.deepEqual(inv.snapshot(), []);\n});\n","tool_call_id":"H8UoOdEcOfNK1pGayVMCFLiptX92XwwH"},{"role":"assistant","content":"I've reviewed the README rules against the code. I found three bugs:\n\n1. **`release()`** never normalizes the SKU (violates R1 — `\" x\"` should work same as `\"X\"`).\n2. **`remove()`** only checks `qty > entry.onHand` — it allows removing reserved stock (violates R6).\n3. **`snapshot()`** sorts with `localeCompare` instead of plain code-unit order (violates R7).\n\nFixing them now:\n\n","reasoning_content":"Let's compare the code against the README's rules:\n\nR1. SKUs are trimmed and uppercased. All methods that accept a SKU do this first. Non-string or empty-after-trim → TypeError.\n- `normalizeSku` is correct.\n- Bug: `release()` doesn't call `normalizeSku(sku)` — it does `this.#entry(sku)` with the raw sku. So `inv.release(\" x\", 1)` won't find \"X\". Fix: normalize first.\n\nR2. Quantity is a