{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@earendil-works/chord": ["./pi/packages/chord/src/index.ts"],
			"@earendil-works/chord/bundler": ["./pi/packages/chord/src/bundler.ts"],
			"@earendil-works/chord/context": ["./pi/packages/chord/src/context/index.ts"],
			"@earendil-works/chord/delta": ["./pi/packages/chord/src/delta/index.ts"],
			"@earendil-works/chord/node": ["./pi/packages/chord/src/node.ts"],
			"@earendil-works/pi-telemetry": ["./pi/packages/telemetry/src/index.ts"],
			"@earendil-works/pi-telemetry/testing": ["./pi/packages/telemetry/src/testing/index.ts"],
			"@earendil-works/pi-ai": ["./pi/packages/ai/src/index.ts"],
			"@earendil-works/pi-ai/oauth": ["./pi/packages/ai/src/oauth.ts"],
			"@earendil-works/pi-ai/*": ["./pi/packages/ai/src/*.ts", "./pi/packages/ai/src/providers/*.ts"],
			"@earendil-works/pi-ai/dist/*": ["./pi/packages/ai/src/*"],
			"@earendil-works/pi-durable": ["./pi/packages/durable/src/index.ts"],
			"@earendil-works/pi-durable/testing": ["./pi/packages/durable/src/testing/index.ts"],
			"@earendil-works/pi-durable/*": ["./pi/packages/durable/src/*"],
			"@earendil-works/pi-agent-core": ["./pi/packages/agent/src/index.ts"],
			"@earendil-works/pi-agent-core/harness/session/testing": [
				"./pi/packages/agent/src/harness/session/testing/index.ts"
			],
			"@earendil-works/pi-agent-core/experimental/pico3": [
				"./pi/packages/agent/src/harness/pico3/index.ts"
			],
			"@earendil-works/pi-agent-core/node": ["./pi/packages/agent/src/node.ts"],
			"@earendil-works/pi-agent-core/*": [
				"./pi/packages/agent/src/*.ts",
				"./pi/packages/agent/src/*/index.ts",
				"./pi/packages/agent/src/*"
			],
			"@earendil-works/pi-session-backend-sqlite-node": [
				"./pi/packages/session-backends/sqlite-node/src/index.ts"
			],
			"@earendil-works/pi-coding-agent": ["./pi/packages/coding-agent/src/index.ts"],
			"@earendil-works/pi-coding-agent/experimental/plugin": [
				"./pi/packages/coding-agent/src/experimental/plugin.ts"
			],
			"@earendil-works/pi-coding-agent/experimental/*": [
				"./pi/packages/coding-agent/src/experimental/*.ts"
			],
			"@earendil-works/pi-coding-agent/hooks": ["./pi/packages/coding-agent/src/core/hooks/index.ts"],
			"@earendil-works/pi-coding-agent/*": ["./pi/packages/coding-agent/src/*"],
			"@earendil-works/pi-protocol": ["./pi/packages/protocol/src/index.ts"],
			"@earendil-works/pi-protocol/*": ["./pi/packages/protocol/src/*"],
			"@earendil-works/pi-client": ["./pi/packages/client/src/index.ts"],
			"@earendil-works/pi-client/unix": ["./pi/packages/client/src/unix.ts"],
			"@earendil-works/pi-client/*": ["./pi/packages/client/src/*"],
			"@earendil-works/pi-server": ["./pi/packages/server/src/index.ts"],
			"@earendil-works/pi-server/unix": ["./pi/packages/server/src/transports/unix/index.ts"],
			"@earendil-works/pi-server/*": ["./pi/packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@earendil-works/pi-tui": ["./pi/packages/tui/src/index.ts"],
			"@earendil-works/pi-tui/*": ["./pi/packages/tui/src/*"]
		}
	},
	"files": ["pi/packages/coding-agent/src/utils/highlight-js.d.ts"],
	"include": [
		"protocol/**/*",
		"graph/**/*",
		"visualization/**/*",
		"lab/**/*",
		"runtime/**/*",
		"adapters/**/*",
		"presentation/**/*",
		"cockpit/**/*",
		"research/**/*",
		"tests/**/*",
		"scripts/**/*"
	],
	"exclude": [
		"**/dist/**",
		"node_modules",
		"pi/**",
		"cockpit/main.ts",
		"cockpit/view.ts"
	]
}
