{
	"name": "endophasia",
	"private": true,
	"version": "0.0.0",
	"description": "Endophasia: an experimental research instrument that attaches to an existing agent harness and records what it observes.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noctem-o/endophasia.git"
	},
	"bin": {
		"endo": "dist/cli/index.js"
	},
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"build": "node scripts/build-cli.mjs",
		"test:package": "node scripts/package-smoke.mjs",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"endo": "node cli/index.ts",
		"check:prime-conformance": "node research/prime-conformance/cli.ts",
		"check:prime-conformance:097": "node research/prime-conformance/cli-097.ts",
		"check:prime-conformance:097:offline": "node research/prime-conformance/offline-097.ts",
		"test:pi-real": "vitest --run tests/pi-real-runtime.test.ts",
		"test:acp-omp-real": "vitest --run tests/acp-omp-real.test.ts",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@agentclientprotocol/sdk": "1.7.0",
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"ajv": "8.20.0",
		"typescript": "7.0.2",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
