 Math.floor((153 * ((m + 9) % 12) + 2) / 5) + d - 1;\n  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;\n  return era * 146097 + doe - 719468;\n}\n\nfunction parseMoment(s) {\n  const m = ISO_RE.exec(s);\n  if (!m) return null;\n  const y = +m[1], mo = +m[2], d = +m[3], hh = +m[4], mi = +m[5], ss = +m[6];\n  if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth(y, mo) || hh > 23 || mi > 59 || ss > 59) return null;\n  return daysFromCivil(y, mo, d) * 86400000 + (hh * 3600 + mi * 60 + ss) * 1000;\n}\n```\n\nAnd findConflicts:\n\n```js\nexport function findConflicts(bookings) {\n  if (!Array.isArray(bookings)) throw new TypeError(\"bookings must be an array\");\n\n  const seen = new Set();\n  const valid = [];\n\n  for (const b of bookings) {\n    if (typeof b !== \"object\" || b === null) throw new TypeError(\"booking must be an object\");\n    if (typeof b.id !== \"string\" || b.id === \"\") throw new TypeError(\"booking id must be a non-empty string\");\n    if (typeof b.room !== \"string\" || b.room === \"\") throw new TypeError(\"booking room must be a non-empty string\");\n    if (typeof b.start !== \"string\") throw new TypeError(\"booking start must be a string\");\n    if (typeof b.end !== \"string\") throw new TypeError(\"booking end must be a string\");\n    const start = parseMoment(b.start);\n    const end = parseMoment(b.end);\n    if (start === null) throw new TypeError(\"booking start is not a valid ISO moment\");\n    if (end === null) throw new TypeError(\"booking end is not a valid ISO moment\");\n    if (end <= start) throw new RangeError(\"booking end must be after start\");\n    if (seen.has(b.id)) throw new TypeError(\"duplicate booking id: \" + b.id);\n    seen.add(b.id);\n    valid.push({ id: b.id, room: b.room, start, end });\n  }\n\n  const pairs = [];\n  for (let i = 0; i < valid.length; i++) {\n    for (let j = i + 1; j < valid.length; j++) {\n      const a = valid[i], b = valid[j];\n      if (a.room !== b.room) continue;\n      if (a.start < b.end && b.start < a.end) {\n        pairs.push(a.id < b.id ? [a.id, b.id] : [b.id, a.id]);\n      }\n    }\n  }\n\n  pairs.sort((p, q) => (p[0] === q[0] ? (p[1] < q[1] ? -1 : 1) : (p[0] < q[0] ? -1 : 1)));\n  return pairs;\n}\n```\n\nWait — regarding the order of end/start parsing: R1 for that booking comes before the end check. We validate the start and end strings (both R1) before the end > start check. Good.\n\nAlso, `end <= start` — \"end not after start\" → RangeError when end <= start. Identical range (start==end) → RangeError. Good.\n\nOne more check on daysFromCivil: verify with known values. daysFromCivil(1970,1,1) should be 0. m=1 ≤ 2 → yy=1969. era = floor(1969/400)=4. yoe = 1969-1600=369. mp = (1+9)%12 = 10. doy = floor((153*10+2)/5) + 1 - 1 = floor(1532/5) = 306. doe = 369*365 + floor(369/4) - floor(369/100) + 306 = 134685 + 92 - 3 + 306 = 135080. era*146097 = 584388. Total = 584388 + 135080 - 719468 = 0. ✓\n\nVerify with 2026-03-01: don't do it by hand; trust the algorithm (Hinnant's well-known one).\n\nAlso double-check the month mapping in Hinnant: mp = (m + 9) % 12 — March is m=3 → 0, April 1... yes, mp is 0=March...9=February. doy = floor((153*mp+2)/5) + d - 1. For mp=10 (January): floor(1532/5)=306. Correct (days before January in the year starting in March: March 31 + April 30 + ... + December 31 = 335; hmm, wait).\n\nYear starts in March. Days before January (mp=10) = days from March to December = 31+30+31+30+31+31+30+31+30+31 = 306? March 31, April 30 (61), May 31 (92), June 30 (122), July 31 (153), August 31 (184), September 30 (214), October 31 (245), November 30 (275), December 31 (306). Yes, 306. ✓\n\nTest 1: booking b: R1 09:00–10:00, a: R1 09:30–11:00. Overlap: 09:00 < 11:00 and 09:30 < 10:00 → conflict. Pair: \"a\" < \"b\" → [\"a\",\"b\"]. ✓\n\nTest 2: different rooms → []. ✓\n\nLet's also think about whether the `valid` objects mutate anything — no, they're new objects.\n\nNow, one question: for duplicate id, 