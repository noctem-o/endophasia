{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"protocol/**/*.ts",
			"graph/**/*.ts",
			"visualization/**/*.ts",
			"lab/**/*.ts",
			"evolution/**/*.ts",
			"trust/**/*.ts",
			"collab/**/*.ts",
			"runtime/**/*.ts",
			"adapters/**/*.ts",
			"research/**/*.ts",
			"models/**/*.ts",
			"storage/**/*.ts",
			"cli/**/*.ts",
			"scripts/**/*.ts",
			"tests/**/*.ts",
			"!node_modules"
		]
	}
}
